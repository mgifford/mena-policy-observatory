{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mgifford.github.io/mena-policy-observatory/schemas/research-record.schema.json",
  "title": "Research record",
  "description": "Structured research fields for one policy record. This file does not replace the Markdown artifacts and does not establish legal effect.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "artifacts", "sources", "provisions", "interpretations", "relations"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_notes", "provisions", "interpretations", "related"],
      "properties": {
        "source_notes": {
          "type": "string",
          "pattern": "^[A-Z-]+\\.md$"
        },
        "provisions": {
          "type": "string",
          "pattern": "^[A-Z-]+\\.md$"
        },
        "interpretations": {
          "type": "string",
          "pattern": "^[A-Z-]+\\.md$"
        },
        "related": {
          "type": "string",
          "pattern": "^[A-Z-]+\\.md$"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "source-record.schema.json"
      }
    },
    "provisions": {
      "type": "array",
      "items": {
        "$ref": "provision.schema.json"
      }
    },
    "interpretations": {
      "type": "array",
      "items": {
        "$ref": "interpretation-question.schema.json"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "instrument-relation.schema.json"
      }
    }
  }
}
