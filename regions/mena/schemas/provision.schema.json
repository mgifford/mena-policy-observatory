{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mgifford.github.io/mena-policy-observatory/schemas/provision.schema.json",
  "title": "Provision",
  "description": "One candidate provision of an instrument, as researched. An encoding status is not a legal conclusion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "heading",
    "locator",
    "source_ids",
    "summary",
    "effect_assessment",
    "encoding_status",
    "interpreting_questions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^P-[0-9]{2}$"
    },
    "heading": {
      "type": "string",
      "minLength": 1
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "enum": ["section", "article", "clause", "page", "paragraph", "annex", "document", "unknown"]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "description": "Recorded research interpretation. Not a finding of legal meaning.",
      "type": "string",
      "minLength": 1
    },
    "effect_assessment": {
      "enum": [
        "not_assessed",
        "draft_not_in_force",
        "in_force_confirmed",
        "not_in_force_confirmed",
        "indeterminate"
      ]
    },
    "encoding_status": {
      "enum": ["blocked", "candidate", "tested", "reviewed"]
    },
    "interpreting_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
